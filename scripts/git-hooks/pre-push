#!/usr/bin/env bash
# Pre-push checks: the quick checks CI runs, so a failure shows up here
# instead of on the PR. Linked into .git/hooks by scripts/install-git-hooks.mjs
# (npm's prepare step). Bypass with `git push --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Checks run with the installed packages, so those must match the lockfile;
# otherwise e.g. an outdated Prettier passes or fails different files than CI
if ! node scripts/check-node-modules.mjs; then
    echo "pre-push: run 'npm ci', then push again." >&2
    exit 1
fi

npm run --silent format:check
npm run --silent typecheck
